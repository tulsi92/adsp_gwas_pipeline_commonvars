localrules: main

rule main:
    input:
        expand(
           "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.filtered.gds",
           zip,
           basename = config_tab.BASENAME.values.tolist(),
           strata = config_tab.STRATA.values.tolist(),
           outcome = config_tab.OUTCOME.values.tolist(),
           refp_super_pops = config_tab.REFP_SUPER_POPS.values.tolist(),
           filter_name = config_tab.FILTER_NAME.values.tolist())

####################################
## Filter variants by annotations ##
####################################
## Common variants: MAF>1%
## Rare exonic variants: MAF<1% and protein coding
rule filter_variants_by_annot:
    input:
        gds = lambda wc: getconf(wc, 'ADSP_GENO_GDS'),
        variant_annot = lambda wc: getconf(wc, 'ADSP_VARIANT_ANNOT')
    output:
        gds = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.filtered.gds"
    resources:
        walltime = "100:00",
        mem_mb = 40000
    threads: 10
    container: "/sc/arion/projects/load/users/patelt16/resources/containers/04192023-github-ci_analysis.sif"
    params:
        snp_filter = lambda wc: getconf(wc, 'SNP_FILTER'),
        impact_filter = lambda wc: getconf(wc, 'IMPACT_FILTER'),
        snp_maf = lambda wc: getconf(wc, 'SNP_MAF'),
        snp_type = lambda wc: getconf(wc, 'SNP_TYPE')
    script: "scripts/Snakefile.filter_variants_by_annot.R"
