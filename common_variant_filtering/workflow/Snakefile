rule merge_chr_variant_filterlist:
    input:
        chr_variant_flags = expand("output/{{basename}}/{{strata}}/{{outcome}}/{{refp_super_pops}}/{{filter_name}}/variant_assoc/{{basename}}_{{strata}}.chr{chr}.variant_qc_flags_filterlist.tsv", chr=CHROMOSOMES)
    output:
        chrall_variant_flags = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/report/{basename}_{strata}.chrall.variant_qc_flags_filterlist.tsv"
    resources:
        walltime = "1:00",
        mem_mb = 8000
    threads: 4
    container: "/sc/arion/projects/load/users/patelt16/resources/containers/04192023-github-ci_analysis.sif"
    shell:
        """
        mlr --csv --fs "\t" cat then sort -n variant.id {input.chr_variant_flags} > {output.chrall_variant_flags}
        """

######################################
## Merge chr VCFs to GDS and filter ##
######################################
rule merge_vcf_to_gds:
    input:
        chr_vcf = expand("output/{{basename}}/{{strata}}/{{outcome}}/{{refp_super_pops}}/{{filter_name}}/{{basename}}_{{strata}}.chr{chr}.vcf.gz", chr=CHROMOSOMES)
    output:
        merged_gds = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.gds"
    resources:
        walltime = "4:00",
        mem_mb = 10000
    threads: 8
    container: "/sc/arion/projects/load/users/patelt16/resources/containers/04192023-github-ci_analysis.sif"
    script: "scripts/Snakefile.merge_vcf_to_gds.R"

rule filter_gds_by_qc_flags:
    input:
        gds = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.gds",
        variant_filterlist = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/report/{basename}_{strata}.chrall.variant_qc_flags_filterlist.tsv"
    output:
        filtered_gds = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.qc_filtered.gds"
    resources:
        walltime = "4:00",
        mem_mb = 10000
    threads: 8
    container: "/sc/arion/projects/load/users/patelt16/resources/containers/04192023-github-ci_analysis.sif"
    script: "scripts/Snakefile.filter_gds_by_qc_flags.R"

rule gds_to_plink:
    input:
        gds = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.qc_filtered.gds"
    output:
        bed = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.qc_filtered.bed",
        bim = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.qc_filtered.bim",
        fam = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.qc_filtered.fam"
    params:
        plink_prefix = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.qc_filtered"
    resources:
        walltime = "4:00",
        mem_mb = 8000
    threads: 8
    container: "/sc/arion/projects/load/users/patelt16/resources/containers/04192023-github-ci_analysis.sif"
    script: "scripts/Snakefile.gds_to_plink.R"
