rule filter_sample_pheno_and_merge_covars:
    input: 
        gds = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.filtered.gds",
        sample_pheno_tsv = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.sample_pheno.tsv",
        sample_qc_summary_tsv = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/report/{basename}_{strata}.chrall.sample_qc_summary.tsv",
        wes_capture_kit_info_tsv = "/sc/arion/projects/load/data-ext/ADSP/ADSP_Umbrella_ng00067.v7/misc/gcad.r2.wes.20504.VCPA1.1.2019.11.01.v3.qcmetrics.seq.ALL.txt"
    output: 
        sample_pheno_filtered_merged_tsv = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.sample_pheno_merged_covars.tsv"
    resources:
        walltime = "1:00",
        mem_mb = 8000
    threads: 2
    container: "/sc/arion/projects/load/users/patelt16/resources/containers/04192023-github-ci_analysis.sif"
    script: "scripts/Snakefile.filter_and_merge_covars.R"

rule create_chr_vcf:
    input:
        gds = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.filtered.gds",
        sample_pheno_tsv = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.sample_pheno_merged_covars.tsv"
    output:
        chr_vcf = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chr{chr}.vcf.gz"
    resources:
        walltime = "4:00",
        mem_mb = 10000
    threads: 4
    container: "/sc/arion/projects/load/users/patelt16/resources/containers/04192023-github-ci_analysis.sif"
    script: "scripts/Snakefile.create_chr_vcf.R"

