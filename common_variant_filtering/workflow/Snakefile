rule merge_chr_variant_qc_metrics:
    input:
        variant_heterozygosity_tsv = expand("output/{{basename}}/{{strata}}/{{outcome}}/{{refp_super_pops}}/{{filter_name}}/{{basename}}_{{strata}}.chr{chr}.variant_heterozygosity.tsv", chr = CHROMOSOMES),
        variant_hwe_tsv = expand("output/{{basename}}/{{strata}}/{{outcome}}/{{refp_super_pops}}/{{filter_name}}/{{basename}}_{{strata}}.chr{chr}.variant_hwe.tsv", chr = CHROMOSOMES),
        variant_hwe_qq_tsv = expand("output/{{basename}}/{{strata}}/{{outcome}}/{{refp_super_pops}}/{{filter_name}}/{{basename}}_{{strata}}.chr{chr}.variant_hwe_qq.tsv", chr = CHROMOSOMES),
        variant_diff_missingness_tsv = expand("output/{{basename}}/{{strata}}/{{outcome}}/{{refp_super_pops}}/{{filter_name}}/{{basename}}_{{strata}}.chr{chr}.variant_differential_missingness.tsv", chr = CHROMOSOMES)
    output:
        variant_heterozygosity_tsv = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.variant_heterozygosity.tsv",
        variant_hwe_qq_tsv = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.variant_hwe_qq.tsv",
        variant_hwe_tsv = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.variant_hwe.tsv",
        variant_diff_missingness_tsv = "output/{basename}/{strata}/{outcome}/{refp_super_pops}/{filter_name}/{basename}_{strata}.chrall.variant_differential_missingness.tsv"
    params:
        snp_maf = lambda wc: getconf(wc, 'SNP_MAF'),
        missing_rate = lambda wc: getconf(wc, 'MISSING_RATE'),
        refp_super_pops = lambda wc: getconf(wc, 'REFP_SUPER_POPS')
    resources:
        walltime = "100:00",
        mem_mb = 40000
    threads: 8
    container: "/sc/arion/projects/load/users/patelt16/resources/containers/04192023-github-ci_analysis.sif"
    shell: 
        """
        mlr --csv --fs "\t" cat then sort -n variant.id {input.variant_heterozygosity_tsv} > {output.variant_heterozygosity_tsv}
        mlr --csv --fs "\t" cat then sort -n variant.id {input.variant_hwe_tsv} > {output.variant_hwe_tsv}
        mlr --csv --fs "\t" cat then sort -n variant.id {input.variant_hwe_qq_tsv} > {output.variant_hwe_qq_tsv}
        mlr --csv --fs "\t" cat then sort -n variant.id {input.variant_diff_missingness_tsv} > {output.variant_diff_missingness_tsv}
        """

