## Extract snpeff variant annotations from vcf to tsv
rule extract_chr_variant_annot:
    input:
        chr_vcf = "output/{basename}/{basename}.biallelic_decomposed_multiallelic.gnomad.{gnomad_version}_annot.chr{chr}.vcf.gz"
    output:
        variant_annot_tsv = "output/{basename}/{basename}.biallelic_decomposed_multiallelic.gnomad.{gnomad_version}_annot.chr{chr}.variant_annot.tsv"
    resources:
        time_min = RUNTIME_MIN.get('default'),
        mem_mb = MEMORY_MB.get('extra-low')
    threads: 2
    shell: """
java -Xms32g -jar {SNPSIFT_JAR} extractFields {input} ID CHROM POS REF ALT ANN[0].GENEID ANN[0].FEATUREID ANN[0].HGVS_C ANN[0].IMPACT ANN[0].EFFECT ANN[0].BIOTYPE ANN[0].GENE ANN[0].HGVS_P > {output}
"""

## Merge snpeff variant annotations
rule merge_chr_variant_annot:
