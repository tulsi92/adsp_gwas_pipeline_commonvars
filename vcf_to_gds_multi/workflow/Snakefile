## Determine which params to use depending on adsp version
def process_chr_vcf_cohort_rule(wc):
    if wc['basename'] == "adsp.r2.wes" or wc['basename'] == "adsp.r3.wgs":
        return "bcftools annotate -x ^FORMAT/GT | \\"
    else:
        return ""

## Determine which filters to use depending on adsp version
def process_chr_vcf_wes_filters(wc):
    if wc['basename'] == "adsp.r2.wes":
        return """awk '{{ \\
                gsub(/ADSP_Discovery-Nimblegen_VCRome_V2\.1/, "ADSP_Discovery_Nimblegen_VCRome_V2_1"); \\
                gsub(/ADSP_Discovery-Illumina_Rapid_Capture_Exome_\(ICE\)_kit/, "ADSP_Discovery_Illumina_Rapid_Capture_Exome__ICE__kit"); \\
                gsub(/ADGC_AA-Agilent_WES_v6_capture_region/, "ADGC_AA_Agilent_WES_v6_capture_region"); \\
                gsub(/FASe_Families-Agilent_WES_v5_capture_region/, "FASe_Families_Agilent_WES_v5_capture_region"); \\
                gsub(/FASe_Families-Nimblegen_VCRome_sequencing_w-Custom_Spike-In_Baits/, "FASe_Families_Nimblegen_VCRome_sequencing_w_Custom_Spike_In_Baits"); \\
                gsub(/FASe_Families-Nimblegen_VCRome_V2\.1/, "FASe_Families_Nimblegen_VCRome_V2_1"); \\
                gsub(/Brkanac_Families-Roche_SeqCap_EZ_Exome_Probes_v2\.0_Target_Enrichment_Probes/, "Brkanac_Families_Roche_SeqCap_EZ_Exome_Probes_v2_0_Target_Enrichment_Probes"); \\
                gsub(/Miami_Families-Agilent_WES_v3_capture_region/, "Miami_Families_Agilent_WES_v3_capture_region"); \\
                gsub(/Miami_Families-Agilent_WES_v4_capture_region/, "Miami_Families_Agilent_WES_v4_capture_region"); \\
                gsub(/Columbia_WHICAP-Roche_SeqCap_EZ_Exome_Probes_v3\.0_Target_Enrichment_Probes/, "Columbia_WHICAP_Roche_SeqCap_EZ_Exome_Probes_v3_0_Target_Enrichment_Probes"); \\
                gsub(/KnightADRC-Nimblegen_VCRome_sequencing_w-Custom_Spike-In_Baits/, "KnightADRC_Nimblegen_VCRome_sequencing_w_Custom_Spike_In_Baits"); \\
                gsub(/KnightADRC-IDT_xGen_Exome_Whole_Exome_Research_Panel_v1\.0_w-Custom_Spike-In_Baits/, "KnightADRC_IDT_xGen_Exome_Whole_Exome_Research_Panel_v1_0_w_Custom_Spike_In_Baits"); \\
                gsub(/CBD-Agilent_WES_v5_capture_region/, "CBD_Agilent_WES_v5_capture_region"); \\
                gsub(/PSP-Nimblegen_VCRome_V2\.1/, "PSP_Nimblegen_VCRome_V2_1"); \\
                print }}' | """
    else:
        return ""

