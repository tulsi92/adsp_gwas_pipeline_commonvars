## Reheader vcfs to fix ABHet column with multiple values per variant
rule reheader_vcf_to_fix:
    input: "output/{basename}/{basename}.biallelic_decomposed_multiallelic.sorted.chr{chr}.vcf.gz"
    output: "output/{basename}/{basename}.biallelic_decomposed_multiallelic.sorted_reheader.chr{chr}.vcf.gz"
    resources:
        walltime = "5:00",
        mem_mb = MEMORY_MB.get('low')
    params:
    threads: 2
    conda: "envs/bcftools.yaml"
    shell: """
bcftools view -h {input} | sed 's/ID=ABHet_One_subgroup,Number=1/ID=ABHet_One_subgroup,Number=./' | bcftools reheader -h /dev/stdin -o {output} {input}
"""

## Merge all vcfs and convert to gds using LZ4_RA compression
rule convert_chr_vcfs_to_gds:
    input: expand("output/{{basename}}/{{basename}}.biallelic_decomposed_multiallelic.sorted_reheader.chr{chr}.vcf.gz", chr=CHROM)
    output: "output/{basename}/{basename}.biallelic_decomposed_multiallelic.chrall.gds"
    resources:
        walltime = "200:00",
        mem_mb = MEMORY_MB.get('extra-low')
    threads: 4
    conda: "envs/r.yaml"
    script: "scripts/Snakefile.convert_chr_vcfs_to_gds.R"

## Filter vcfs for PCA maf to generate separate PCA GDS-makes PCA step faster
rule filter_vcf_for_maf_pca:
    input: "output/{basename}/{basename}.biallelic_decomposed_multiallelic.sorted_reheader.chr{chr}.vcf.gz"
    output: temp("output/{basename}/{basename}.biallelic_decomposed_multiallelic.chr{chr}_pca_maf{pca_maf}.vcf.gz")
    resources:
        walltime = "140:00",
        mem_mb = MEMORY_MB.get('extra-low')
    params:
        pca_maf = PCA_MAF
    threads: 4
    conda: "envs/bcftools.yaml"
    shell: """
bcftools view --min-af {params.pca_maf}:minor {input} -Ov -o {output}
"""

## Merge all filtered vcfs and convert to gds for PCA using LZ4_RA compression
rule convert_chr_vcfs_to_gds_for_pca:
    input: expand("output/{{basename}}/{{basename}}.biallelic_decomposed_multiallelic.chr{chr}_pca_maf{{pca_maf}}.vcf.gz", chr=CHROM)
    output: "output/{basename}/{basename}.biallelic_decomposed_multiallelic.chrall_pca_maf{pca_maf}.gds"
    resources:
        walltime = "200:00",
        mem_mb = MEMORY_MB.get('extra-low')
    params:
        pca_maf = PCA_MAF
    threads: 4
    conda: "envs/r.yaml"
    script: "scripts/Snakefile.convert_chr_vcfs_to_gds.R"
