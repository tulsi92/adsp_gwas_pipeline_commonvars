rule decompose_multiallelic_vcf:
    input: lambda wc: getconf(wc, 'MULTI_GENOTYPES')
    output: "output/{basename}/{basename}.first_decomposed_multiallelic.chr{chr}.vcf.gz"
    threads: 4
    resources:
        walltime = "48:00",
        mem_mb = MEMORY_MB.get('default')
    params:
    conda: "envs/bcftools.yaml"
    shell: """
vt decompose -s {input} -o {output}
"""

rule process_chr_vcf_multiallelic:
    input:
        rename = "input/rename-chrs.txt",
        vcf = "output/{basename}/{basename}.first_decomposed_multiallelic.chr{chr}.vcf.gz"
    output: "output/{basename}/{basename}.decomposed_multiallelic_vflag_filt.chr{chr}.vcf.gz"
    threads: 4
    resources:
        walltime = "48:00",
        mem_mb = MEMORY_MB.get('low')
    params:
        snpeff_genome = lambda wc: getconf(wc, 'SNPEFF_GENOME'),
        filter_multiallelic = "VFLAGS_One_subgroup = 0"
    conda: "envs/bcftools.yaml"
    shell: """
bcftools view {input.vcf} -Ov | \\
    java -Xmx32g -jar {SNPEFF_JAR} {params.snpeff_genome} -noStats | \\
    java -Xmx32g -jar {SNPSIFT_JAR} filter "{params.filter_multiallelic}" | \\
    bcftools annotate --rename-chrs {input.rename} --set-id '%CHROM:%POS:%REF:%ALT' -Ov | \\
    awk '$0 !~ "^##contig=<ID=(chr|HLA)|^##GATKCommandLine=|^##bcftools_" || $0 ~ "^##contig=<ID=chr{wildcards.chr},"' | \\
    bcftools view -Oz -o {output}
    """

