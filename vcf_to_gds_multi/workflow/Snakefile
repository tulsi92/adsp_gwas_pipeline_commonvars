config_tab = pd.read_table("config_files/config.tsv")
config_tab = config_tab.replace({np.nan: None})

def getconf(wc, col, freecols=None, delist=True):
    '''
    Returns the specified config item from the config file where
    wildcards with a mapped config item match the config file.
    Will error if the number of matching config files is not
    exactly one.
    '''
    col_matches = [v == config_tab[k.upper()] for k, v in wc.items()
                   if k.upper() in config_tab.columns]
    col_match_array = np.array(col_matches, dtype=bool)
    all_cols_match = np.logical_and.reduce(col_match_array)
    matching_rows = config_tab[all_cols_match]
    if freecols and type(freecols) in [list, str]:
        matching_rows_dex = matching_rows.drop(labels=freecols, axis=1).copy()
        matching_rows_dex = matching_rows_dex.drop_duplicates().index
        matching_rows = matching_rows.loc[matching_rows_dex]
    assert matching_rows.shape[0] != 0, "No matching config row for wildcards"
    assert matching_rows.shape[0] == 1, "More than 1 matching config row for wildcards"
    return matching_rows.iloc[0][col]

